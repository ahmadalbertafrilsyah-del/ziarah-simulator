import "maplibre-gl/dist/maplibre-gl.css";
import "./globals.css";

export const metadata = { title: "Ziarah Walisongo | Perjalanan Vespa", description: "Pilih teman perjalanan, jelajahi peta Indonesia, dan temukan cerita di setiap persinggahan." };

export default function RootLayout({ children }) { return <html lang="id"><body>{children}</body></html>; }
